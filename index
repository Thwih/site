  let url = '';
  if (platform === 'yt') {
    url = 'https://www.youtube.com/@thxmod01';
    document.getElementById('verifyYtBtn').disabled = true; 
  } else if (platform === 'tg') {
    url = 'https://t.me/thwihmod';
    document.getElementById('verifyTgBtn').disabled = true; 
  }
  window.open(url, '_blank');
  verifyTimeLeft = Math.max(0, verifyTimeLeft - 30);
  document.getElementById('verifyTimer').innerText = verifyTimeLeft + 's';
  if (verifyTimeLeft === 0) {
    clearInterval(verifyTimerInterval);
    const btnEl = document.getElementById('getFinalLinkBtn');
    btnEl.disabled = false;
    btnEl.innerHTML = '<i class="fa-solid fa-unlock"></i> Lấy Link Ngay';
  }
}

function closeVerifyModal() {
  document.getElementById('verifyModal').classList.remove('active');
  clearInterval(verifyTimerInterval);
}

document.getElementById('getFinalLinkBtn').addEventListener('click', () => {
  if (!verifyTargetLink) return;
  window.open(verifyTargetLink, '_blank');
  closeVerifyModal();
});

// === API & TIMEOUT LOGIC (LOẠI TRỪ NÚT BỐC ACC LQ) ===
setTimeout(() => {
  document.querySelectorAll('.app-btn:not(.lq-acc-btn)').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation(); 
      if (btn.disabled) return; 
      
      const isDownloadBtn = btn.classList.contains('primary');
      const type = isDownloadBtn ? 'download' : 'getkey';
      const targetUrl = btn.getAttribute('data-url') || 'https://www.youtube.com/@thxmod01';
      const fallbackUrl = btn.getAttribute('data-fallback') || 'https://t.me/thwihmod';
      
      btn.disabled = true;
      const toastObj = showToast(
        isDownloadBtn ? 'Đang chuẩn bị tải' : 'Đang lấy Key', 
        isDownloadBtn ? 'Đang kiểm tra IP và tạo link...' : 'Đang tạo link lấy Key...', 
        'loading', 
        0
      );

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 10000);

      try {
        const workerUrl = `https://thxmod-api.weylynofficial.workers.dev/?url=${encodeURIComponent(targetUrl)}&link_du_phong=${encodeURIComponent(fallbackUrl)}&type=${type}`;
        const response = await fetch(workerUrl, { signal: controller.signal });
        clearTimeout(timeoutId);
        const data = await response.json();

        if (toastObj) dismissToast(toastObj.element);

        if (data.success === true && data.link) {
          startVerificationModal(data.link);
          showToast('Thành công', 'Vui lòng hoàn tất xác minh để nhận link!', 'info', 3000);
        } else {
          if (data.error === 'IP_NOT_VALID') {
            showToast('Lỗi IP', data.message, 'warning', 6000);
          } else if (data.error === 'LIMIT_REACHED') {
            showToast('Hết lượt tải', data.message, 'warning', 6000);
          } else {
            window.open(fallbackUrl, '_blank');
            showToast('Lưu ý', data.message || 'Không thể tạo link, đã mở link dự phòng!', 'warning', 5000);
          }
        }
        setTimeout(() => { btn.disabled = false; }, 2000);
      } catch (error) {
        clearTimeout(timeoutId);
        if (toastObj) dismissToast(toastObj.element);
        console.error('Fetch Error:', error);
        window.open(fallbackUrl, '_blank');
        showToast('Lỗi hệ thống', 'Server phản hồi chậm hoặc lỗi, đang mở link dự phòng!', 'warning', 5000);
        setTimeout(() => { btn.disabled = false; }, 5000);
      }
    });
  });
}, 100);

// === DYNAMIC BADGE TOGGLE (ONLY TEXT & COLOR) ===
setTimeout(() => {
  const badges = document.querySelectorAll('.dynamic-badge');
  setInterval(() => {
    badges.forEach(badge => {
      if (badge.classList.contains('showing-os')) {
        // Chuyển sang Status
        badge.classList.remove('showing-os', 'android', 'ios');
        badge.classList.add('showing-status', badge.getAttribute('data-status'));
        badge.innerHTML = `<i class="fa-solid ${badge.getAttribute('data-status-icon')}"></i> ${badge.getAttribute('data-status-text')}`;
      } else {
        // Chuyển sang OS
        badge.classList.remove('showing-status', 'active', 'update', 'error');
        const osClass = badge.getAttribute('data-os').toLowerCase();
        badge.classList.add('showing-os', osClass);
        badge.innerHTML = `<i class="fa-brands fa-${osClass}"></i> ${badge.getAttribute('data-os')}`;
      }
    });
  }, 60000); // Chuyển đổi mỗi 1 phút (60 giây)
}, 500); // Đợi data.js tải xong
</script>
