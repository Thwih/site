<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thx Mod — Free Fire Mod Menu (Android & iOS)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Nunito:wght@300;400;500;600;700;800;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{
  --bg:#f4f7ff; --bg-2:#ffffff; --card:rgba(255, 255, 255, 0.5); --border:rgba(255, 255, 255, 0.6);
  --purple:#8c55fa; --purple-soft:#6d28d9; --blue:#4263eb; --cyan:#0ca678; --text:#000000; --muted:#333333;
  --grad:linear-gradient(135deg, rgb(140, 85, 250) 0%,rgb(200, 215, 253) 75%,rgb(143, 230, 243) 100%);
  --glass-shadow: 0 8px 32px rgba(140, 85, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  --glass-border: 1px solid rgba(255, 255, 255, 0.6);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:'Nunito', sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;-webkit-font-smoothing:antialiased;user-select:none}
.mono{font-family:'Comfortaa', cursive; letter-spacing: 0.02em;} 
.disp{font-family:'Quicksand', sans-serif;font-weight:700;letter-spacing:-.02em}
h1, h2, h3, h4, h5, .btn, .app-btn, .app-tab, .nav-cta, .nav-links, .sidebar-link, .faq-q, .preloader-text {font-family:'Quicksand', sans-serif;}
img {-webkit-user-drag: none;user-drag: none;pointer-events: none;}

/* PRELOADER */
#preloader {position: fixed;inset: 0;z-index: 9999;background: rgba(244, 247, 255, 0.8);backdrop-filter: blur(30px) saturate(180%);-webkit-backdrop-filter: blur(30px) saturate(180%);display: flex;align-items: center;justify-content: center;transition: opacity 0.6s ease, visibility 0.6s ease;}
#preloader.hidden {opacity: 0;visibility: hidden;}
.preloader-content {text-align: center;width: 320px;padding: 0;}
.spinner {width: 56px;height: 56px;border: 4px solid rgba(140, 85, 250, 0.1);border-top-color: #8c55fa;border-right-color: #4263eb;border-bottom-color: #8fe6f3;border-left-color: transparent;border-radius: 50%;animation: spin 1s linear infinite;margin: 0 auto 24px;box-shadow: 0 0 20px rgba(140, 85, 250, 0.2);}
@keyframes spin {to {transform: rotate(360deg);}}
.preloader-text {font-size: 16px;font-weight: 700;color: var(--text);margin-bottom: 24px;letter-spacing: 0.5px;}
.progress-container {width: 100%;height: 6px;background: rgba(255, 255, 255, 0.4);border: 1px solid rgba(255, 255, 255, 0.6);backdrop-filter: blur(4px);border-radius: 10px;overflow: hidden;margin-bottom: 12px;position: relative;box-shadow: 0 4px 15px rgba(140, 85, 250, 0.05);}
.progress-bar {height: 100%;width: 0%;position: relative;background: linear-gradient(90deg, #8c55fa, #4263eb, #8fe6f3);border-radius: 10px;box-shadow: 0 0 10px rgba(140, 85, 250, 0.6);transition: width 0.2s ease-out;overflow: hidden;}
.progress-bar::after {content: '';position: absolute;top: 0;left: -60px;width: 60px;height: 100%;background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);filter: blur(4px);animation: streak 1.5s linear infinite;pointer-events: none;}
@keyframes streak {0% {left: -60px;}100% {left: 100%;}}
.progress-text {font-family: 'Comfortaa', cursive;font-size: 12px;color: var(--muted);letter-spacing: 1px;font-weight: 600;}

/* BACKGROUND */
.bg-grid{position:fixed;inset:0;z-index:-2;background:radial-gradient(1200px 800px at 80% -10%, rgba(140,85,250,.2), transparent 60%),radial-gradient(900px 600px at -10% 30%, rgba(143,230,243,.2), transparent 60%),radial-gradient(700px 500px at 50% 110%, rgba(200,215,253,.25), transparent 60%),var(--bg);}
.bg-grid::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(140,85,250,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(140,85,250,.04) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 75%);-webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 75%);}
.noise{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.03;mix-blend-mode:overlay;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");}
.cursor-glow{position:fixed;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle, rgba(140,85,250,.15), transparent 60%);pointer-events:none;z-index:0;transform:translate(-50%,-50%);transition:opacity .3s;mix-blend-mode:multiply;}

/* SPARKLES */
.sparkles {position: fixed;inset: 0;pointer-events: none;z-index: 0;}
.sparkle {position: absolute;font-size: 20px;font-weight: 700;line-height: 1;user-select: none;opacity: 0;}

/* SIDEBAR */
.menu-toggle {background: rgba(255, 255, 255, 0.5);backdrop-filter: blur(10px);-webkit-backdrop-filter: blur(10px);border: var(--glass-border);color: var(--text);width: 38px;height: 38px;border-radius: 10px;display: grid;place-items: center;cursor: pointer;transition: .25s;margin-right: 12px;font-size: 16px;}
.menu-toggle:hover {background: rgba(140,85,250,.1);border-color: rgba(140,85,250,.2);}
.sidebar-overlay {position: fixed;inset: 0;z-index: 105;background: rgba(255,255,255,0.4);backdrop-filter: blur(5px);-webkit-backdrop-filter: blur(5px);opacity: 0;pointer-events: none;transition: opacity .3s;}
.sidebar-overlay.active {opacity: 1;pointer-events: auto;}
.sidebar {position: fixed;top: 0;left: -300px;width: 280px;height: 100vh;background: rgba(255, 255, 255, 0.7);backdrop-filter: blur(30px) saturate(180%);-webkit-backdrop-filter: blur(30px) saturate(180%);border-right: var(--glass-border);z-index: 110;transition: left .4s cubic-bezier(.2,.8,.2,1);display: flex;flex-direction: column;padding: 20px;overflow-y: auto;box-shadow: 5px 0 30px rgba(0,0,0,0.05);}
.sidebar.active {left: 0;}
.sidebar-head {display: flex;justify-content: space-between;align-items: center;padding-bottom: 20px;margin-bottom: 20px;border-bottom: 1px solid rgba(0,0,0,0.05);}
.sidebar-close {background: rgba(0,0,0,.03);color: var(--text);border: 1px solid rgba(0,0,0,0.05);width: 34px;height: 34px;border-radius: 8px;cursor: pointer;display: grid;place-items: center;transition: .2s;}
.sidebar-close:hover {background: rgba(255,100,100,.1);border-color: rgba(255,100,100,.2);color: #e03131;}
.sidebar-links {display: flex;flex-direction: column;gap: 8px;}
.sidebar-link {padding: 14px 16px;border-radius: 12px;color: var(--text);text-decoration: none;font-weight: 600;font-size: 15px;display: flex;align-items: center;gap: 14px;transition: .25s;background: rgba(255,255,255,0.4);border: 1px solid transparent;cursor: pointer;}
.sidebar-link i {color: var(--purple);width: 20px;text-align: center;}
.sidebar-link:hover {background: rgba(140,85,250,.1);border-color: rgba(140,85,250,.2);transform: translateX(4px);}
.sidebar-link.lq-link i {color: #0ca678;}
.sidebar-link.lq-link {background: rgba(12, 166, 120, 0.05); border-color: rgba(12, 166, 120, 0.1);}
.sidebar-foot {margin-top: auto;padding-top: 20px;border-top: 1px solid rgba(0,0,0,0.05);}
.sidebar-foot .foot-social {justify-content: center;margin-bottom: 16px;}

/* NAV */
nav.top{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:18px 40px;backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);background:rgba(255,255,255,.6);border-bottom: var(--glass-border);box-shadow: 0 4px 20px rgba(0,0,0,0.03);}
.logo{display:flex;align-items:center;gap:12px;font-weight:700;letter-spacing:-.02em;font-family:'Quicksand', sans-serif;}
.logo-mark{width:38px;height:38px;border-radius:11px;background:var(--grad);display:grid;place-items:center;color:#0a0612;font-weight:900;box-shadow:0 8px 30px rgba(140,85,250,.4), inset 0 1px 0 rgba(255,255,255,.4);position:relative;overflow:hidden;}
.logo-mark::after{content:"";position:absolute;inset:-1px;border-radius:12px;background:var(--grad);z-index:-1;filter:blur(8px);opacity:.6;}
.nav-links{display:flex;gap:30px;font-size:14px;color:var(--muted)}
.nav-links a{color:inherit;text-decoration:none;transition:.25s;position:relative;cursor:pointer;font-weight:600;}
.nav-links a:hover{color:var(--text)}
.nav-links a::after{content:"";position:absolute;left:0;bottom:-6px;width:0;height:1px;background:var(--purple);transition:.3s;}
.nav-links a:hover::after{width:100%}
.nav-cta{padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;background:rgba(140,85,250,.1);backdrop-filter: blur(10px);border:1px solid rgba(140,85,250,.2);color:var(--purple);display:flex;align-items:center;gap:8px;cursor:pointer;transition:.25s;}
.nav-cta:hover{background:rgba(140,85,250,.2);border-color:rgba(140,85,250,.4)}

/* VIEW SYSTEM */
.view {display: none;animation: fadeIn 0.5s ease;}
.view.active {display: block;}
@keyframes fadeIn {from {opacity: 0;transform: translateY(10px);}to {opacity: 1;transform: translateY(0);}}
.section-page {padding-top: 160px;padding-bottom: 80px;}

/* HERO */
.hero{min-height:100vh;padding:160px 40px 80px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;max-width:900px;margin:0 auto;position:relative;}
.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:7px 14px;border-radius:100px;background:rgba(255,255,255,0.5);backdrop-filter: blur(10px);border:1px solid rgba(140,85,250,0.2);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--purple);margin-bottom:40px;box-shadow: 0 4px 15px rgba(140,85,250,0.05);font-family:'Comfortaa', cursive;}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan);animation:pulse 1.8s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
.hero h1{font-size:clamp(48px,7vw,90px);line-height:1.05;margin:0 0 30px;font-weight:800;letter-spacing:-.04em;color:var(--text);}
.hero h1 .grad-title-wrap {display: flex;align-items: center;justify-content: center;gap: 12px;}
.hero h1 .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 10px 30px rgba(140,85,250,.2));display:inline-block;}
.hero-verified-badge {width: clamp(25px, 4vw, 40px);height: auto;filter: drop-shadow(0 4px 10px rgba(66, 99, 235, 0.4));}
.hero h1 .hero-sub{display:block;font-size:0.75em;font-weight:700;color: var(--text);margin-top: 10px;}
.hero p.lead{font-size:18px;color:var(--muted);line-height:1.8;max-width:620px;margin:0 auto 40px;font-weight:500;}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;}
.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 26px;border-radius:13px;font-weight:600;font-size:15px;cursor:pointer;border:none;text-decoration:none;transition:.3s;position:relative;}
.btn-primary{background:linear-gradient(135deg, #8c55fa, #4263eb);color:#fff;box-shadow:0 12px 40px rgba(140,85,250,.4), inset 0 1px 1px rgba(255,255,255,.4);text-shadow: 0 1px 1px rgba(0,0,0,0.1);}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 50px rgba(140,85,250,.55)}
.btn-ghost{background:rgba(255,255,255,0.5);backdrop-filter: blur(10px);-webkit-backdrop-filter: blur(10px);color:var(--text);border:1px solid rgba(0,0,0,0.05);box-shadow: var(--glass-shadow);}
.btn-ghost:hover{background:rgba(255,255,255,0.8);border-color:rgba(140,85,250,.2)}
.hero-stats{display:flex;gap:36px;margin-top:60px;padding-top:40px;border-top:1px solid rgba(0,0,0,0.05);justify-content:center;flex-wrap:wrap;}
.stat .num{font-size:28px;font-weight:800;letter-spacing:-.02em;font-family:'Quicksand', sans-serif;}
.stat .num.grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat .lbl{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-top:4px;font-family:'Comfortaa', cursive;}

/* SECTIONS */
.container{max-width:1400px;margin:0 auto}
.sec-head{margin-bottom:60px;display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap}
.sec-head h2{font-size:clamp(36px,4.5vw,60px);font-weight:700;letter-spacing:-.03em;margin:0;line-height:1;color:var(--text);}
.sec-head h2 .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.sec-head p{color:var(--muted);max-width:420px;line-height:1.6;margin:0;font-weight:500;}

/* LAYOUT DÀNH RIÊNG CHO TRANG ACC LQ (1 CARD GIỮA MÀN HÌNH) */
.lq-grid-center {display: flex; justify-content: center; max-width: 400px; margin: 0 auto;}
.lq-rules-container {max-width: 400px; margin: 30px auto 0; text-align: left; background: rgba(255,255,255,0.5); padding: 20px; border-radius: 16px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.6); box-shadow: var(--glass-shadow);}
.lq-rules-container p {font-size: 13px; color: var(--muted); margin: 8px 0; display: flex; align-items: center; gap: 10px;}
.lq-rules-container i {color: #0ca678; width: 18px; text-align: center;}

/* SEARCH BOX */
.search-box {position: relative; margin: 0 auto 30px; max-width: 400px; width: 100%;}
.search-box i {position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--purple); font-size: 16px; z-index: 2; pointer-events: none;}
.search-box input {width: 100%; padding: 15px 20px 15px 50px; border-radius: 15px; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.6); color: var(--text); font-family: 'Nunito', sans-serif; font-size: 15px; outline: none; transition: .3s; box-shadow: var(--glass-shadow); position: relative; z-index: 1;}
.search-box input::placeholder {color: var(--muted);}
.search-box input:focus {border-color: rgba(140,85,250,0.5); background: rgba(255, 255, 255, 0.9);}

/* TABS */
.app-tabs {display: flex;gap: 10px;margin-bottom: 40px;flex-wrap: wrap; align-items: center;}
.app-tab {padding: 10px 20px;border-radius: 30px;background: rgba(255, 255, 255, 0.5);backdrop-filter: blur(10px);-webkit-backdrop-filter: blur(10px);border: 1px solid rgba(255,255,255,0.6);color: var(--muted);font-size: 13px;font-weight: 600;cursor: pointer;transition: .3s;display: flex;align-items: center;gap: 8px;box-shadow: 0 4px 10px rgba(0,0,0,0.03), inset 0 1px 1px rgba(255,255,255,0.8);}
.app-tab:hover {color: var(--text);border-color: rgba(140,85,250,.3);background: rgba(255, 255, 255, 0.7);}
.app-tab.active {background: linear-gradient(135deg, #8c55fa, #4263eb);color: #fff;border-color: transparent;box-shadow: 0 8px 20px rgba(140,85,250,0.3), inset 0 1px 1px rgba(255,255,255,0.4);text-shadow: 0 1px 1px rgba(0,0,0,0.1);}

/* APP CONTENT */
.app-content {display: none;animation: fadeIn 0.5s ease;}
.app-content.active {display: block;}

/* FEATURES GRID */
.feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.feat-card{background:var(--card);backdrop-filter: blur(16px) saturate(180%);-webkit-backdrop-filter: blur(16px) saturate(180%);border:var(--glass-border);border-radius:18px;padding:28px;position:relative;overflow:hidden;transition:.4s;cursor:pointer;box-shadow: var(--glass-shadow);}
.feat-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,0%), rgba(140,85,250,.15), transparent 60%);opacity:0;transition:.4s;}
.feat-card:hover::before{opacity:1}
.feat-card:hover{transform:translateY(-4px);box-shadow: 0 20px 40px rgba(140,85,250,.1)}
.feat-card .icon{width:44px;height:44px;border-radius:12px;background:rgba(140,85,250,.1);display:grid;place-items:center;color:var(--purple);font-size:18px;margin-bottom:18px;transition:.4s;}
.feat-card:hover .icon{background:var(--grad);color:#fff;transform:scale(1.1)}
.feat-card h3{font-size:16px;font-weight:700;margin:0 0 8px;letter-spacing:-.01em}
.feat-card p{font-size:13px;color:var(--muted);line-height:1.6;margin:0;font-weight:500;}
.feat-card .tag{position:absolute;top:18px;right:18px;font-size:9px;font-weight:700;padding:3px 8px;border-radius:20px;letter-spacing:.08em;text-transform:uppercase;font-family:'Comfortaa', cursive;}
.feat-card .tag.new{background:rgba(143,230,243,.2);color:#0ca678}
.feat-card .tag.hot{background:rgba(255,100,100,.15);color:#e03131}

/* APPS GRID */
.apps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.app-card{background: rgba(255, 255, 255, 0.6);backdrop-filter: blur(20px) saturate(180%);-webkit-backdrop-filter: blur(20px) saturate(180%);border:var(--glass-border);border-radius:20px;padding:0;display:flex;flex-direction:column;position:relative;overflow:hidden;transition: .4s ease;cursor:pointer;box-shadow: var(--glass-shadow);}
.app-card:hover{transform:translateY(-6px);box-shadow: 0 20px 40px rgba(140,85,250,.15);}
.card-banner{position:relative;width:100%;aspect-ratio: 16 / 9;background:#f8fafc;overflow:hidden;border-bottom: 1px solid rgba(0,0,0,0.05);}
.card-banner img{width:100%;height:100%;object-fit:cover;opacity:0.9;transition: opacity .3s ease;pointer-events: none;}
.app-card:hover .card-banner img{opacity:1}

/* DYNAMIC BADGE */
.dynamic-badge {
  position: absolute; top: 14px; right: 14px; font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 100px; z-index: 5; display: flex; align-items: center; gap: 6px; backdrop-filter: blur(8px) saturate(180%); -webkit-backdrop-filter: blur(8px) saturate(180%); letter-spacing: 0.03em; font-family: 'Quicksand', sans-serif; border: 1px solid rgba(255,255,255,0.5); color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  transition: background 0.5s ease, box-shadow 0.5s ease;
}
.dynamic-badge.android { background: rgba(61, 220, 132, 0.35); box-shadow: 0 4px 15px rgba(61, 220, 132, 0.2); }
.dynamic-badge.ios { background: rgba(143, 230, 243, 0.35); box-shadow: 0 4px 15px rgba(143, 230, 243, 0.2); }
.dynamic-badge.active { background: rgba(12, 166, 120, 0.35); box-shadow: 0 4px 15px rgba(12, 166, 120, 0.3); }
.dynamic-badge.update { background: rgba(245, 159, 0, 0.35); box-shadow: 0 4px 15px rgba(245, 159, 0, 0.3); }
.dynamic-badge.error { background: rgba(224, 49, 49, 0.35); box-shadow: 0 4px 15px rgba(224, 49, 49, 0.3); }

.os-badge{position:absolute;top:14px;right:14px;font-size:11px;font-weight:700;padding:6px 14px;border-radius:100px;z-index:5;display:flex;align-items:center;gap:6px;backdrop-filter:blur(8px) saturate(180%);-webkit-backdrop-filter:blur(8px) saturate(180%);letter-spacing:0.03em;font-family:'Quicksand', sans-serif;border:1px solid rgba(255,255,255,0.4);box-shadow: 0 4px 15px rgba(0,0,0,0.1), inset 0 1px 1px rgba(255,255,255,0.5), inset 0 -1px 1px rgba(0,0,0,0.05);}
.os-badge.android {background: linear-gradient(135deg, rgba(61, 220, 132, 0.9), rgba(0, 166, 80, 0.85));color: #fff;text-shadow: 0 1px 2px rgba(0,0,0,0.2);border: 1px solid rgba(255,255,255,0.3);}

.app-info{position:relative;padding: 0 20px 16px;display:flex;flex-direction:column;flex:1;}
.app-header {display: flex;align-items: flex-end;gap: 14px;margin-top: -20px;margin-bottom: 18px;position: relative;z-index: 10;}
.app-icon-small{width:64px;height:64px;border-radius:16px;background:rgba(255,255,255,0.8);backdrop-filter: blur(10px);border: 1px solid rgba(255,255,255,0.9);color:#0a0612;display:grid;place-items:center;font-size:20px;flex-shrink:0;box-shadow:0 8px 20px rgba(0,0,0,.1), inset 0 1px 0 rgba(255,255,255,0.8);overflow:hidden;}
.app-icon-small img {width:100%;height:100%;object-fit:cover;pointer-events: none;}
.app-info-text {display:flex;flex-direction:column;gap: 3px;padding-bottom: 4px;}
.app-info-text h3{margin:0;font-size:14px;font-weight:700;letter-spacing:-.01em;line-height:1.2;color: var(--text);}
.app-info-text .update-date{font-size:10px;color:var(--cyan);font-family:'Comfortaa', cursive;font-weight: 600;}
.app-info-text .lq-count {font-size: 12px; font-weight: 700; color: #0ca678; font-family: 'Quicksand', sans-serif;}
.app-btns{display:flex;gap:10px;margin-top:auto;}
.app-btn{flex:1;padding:11px;border-radius:10px;font-size:11px;font-weight:700;text-align:center;cursor:pointer;border:none;display:flex;align-items:center;justify-content:center;gap:6px;text-transform:uppercase;letter-spacing:.05em;transition:.2s;}
.app-btn:disabled {cursor: not-allowed;opacity: 0.5;transform: none !important;box-shadow: none !important;}
.app-btn.primary{background:linear-gradient(135deg, #8c55fa, #4263eb);color:#fff;box-shadow: 0 6px 16px rgba(140,85,250,0.25), inset 0 1px 1px rgba(255,255,255,0.3);text-shadow: 0 1px 1px rgba(0,0,0,0.1);}
