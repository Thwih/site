// === TOAST NOTIFICATION SYSTEM ===
function showToast(title, message, type = 'info', duration = 2500) {
  const container = document.getElementById('toastContainer');
  if (!container) return null;
  while (container.children.length >= 3) {
    const oldToast = container.firstChild;
    oldToast.classList.add('exit');
    setTimeout(() => oldToast.remove(), 400);
  }
  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  let iconClass = 'fa-bell';
  if (type === 'success') iconClass = 'fa-check';
  if (type === 'warning') iconClass = 'fa-exclamation';
  if (type === 'loading') iconClass = 'fa-spinner';
  toast.innerHTML = `
    <div class="toast-icon"><i class="fa-solid ${iconClass}"></i></div>
    <div class="toast-content"><div class="toast-title">${title}</div><div class="toast-msg">${message}</div></div>
    <button class="toast-close" onclick="dismissToast(this.parentElement)"><i class="fa-solid fa-xmark"></i></button>
    <div class="toast-progress"><div class="toast-progress-bar"></div></div>
  `;
  container.appendChild(toast);
  requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.add('show')));
  const progressBar = toast.querySelector('.toast-progress-bar');
  if (duration > 0 && progressBar) {
    progressBar.style.transition = `transform ${duration}ms linear`;
    void progressBar.offsetWidth; 
    progressBar.style.transform = 'scaleX(1)';
    requestAnimationFrame(() => progressBar.style.transform = 'scaleX(0)');
  } else if (progressBar) {
    progressBar.parentElement.style.display = 'none';
  }
  let hideTimer = null;
  if (duration > 0) hideTimer = setTimeout(() => dismissToast(toast), duration);
  return { element: toast, hideTimer: hideTimer };
}

function dismissToast(toastElement) {
  if (!toastElement || !toastElement.parentElement) return;
  toastElement.classList.remove('show');
  toastElement.classList.add('exit');
  setTimeout(() => { if (toastElement.parentElement) toastElement.remove(); }, 500);
}

